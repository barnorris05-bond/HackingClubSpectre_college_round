{
  "name": "handsfree-notch-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Handsfree Notch Lab - Floating Dynamic Island & VoiceOS Overlay Prototype",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "esbuild electron/main.ts --platform=node --format=esm --outfile=dist-electron/main.js --bundle --external:electron && esbuild electron/preload.ts --platform=node --format=cjs --outfile=dist-electron/preload.cjs --bundle --external:electron",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "electron:dev": "npm run build:electron && electron .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
