# Copy to .env (gitignored). The key is only ever read by the Node server, never sent to the browser.
# Local-first: JEV defaults to http://127.0.0.1:8000 and needs NO key (dummy "local-no-auth" is sent, ignored).
# Only set a key when pointing TYPESAFE_BASE_URL at the cloud.
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# Legacy fallback name, also accepted:
# JEV_API_KEY=

# JEV endpoint override. Unset = hardcoded local http://127.0.0.1:8000 (POST /v1/systemone).
# Cloud: TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_BASE_URL=http://127.0.0.1:8000

# Browser to drive: auto (OS default) or chrome|edge|zen|firefox|chromium.
# Chromium browsers attach to your live tabs when possible; Zen/Firefox get a
# dedicated automation profile (live attach is Chromium-only).
# BROWSER=auto
# CDP local debugging port for live attach (Chromium only).
# CDP_PORT=9222

# Optional
# PORT=8787
